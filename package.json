{
  "name": "koigata",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm build:client && wrangler dev --ip 127.0.0.1 --port 47310 --inspector-port 47311",
    "build:client": "esbuild client/app.ts --bundle --minify --format=esm --target=es2022 --outfile=public/assets/app.js",
    "gen:images": "node scripts/gen-images.ts",
    "deploy": "pnpm build:client && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply koigata --local",
    "db:migrate:remote": "wrangler d1 migrations apply koigata --remote",
    "stats": "node scripts/stats.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "type-check": "tsc --noEmit && tsc --noEmit -p client",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
